{
	"name": "toomas633s-dungeon-frontend",
	"description": "Toomas633's projects homepage frontend",
	"version": "4.5.1",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"serve": "vite preview",
		"build": "vite build",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src/**/*.{ts,vue} tests/**/*.{ts,vue} plugins/**/*.{ts,mjs}",
		"stylelint": "stylelint src/**/*.{css,scss,vue} tests/**/*.{css,scss,vue}",
		"prettier": "prettier --write '**/*.{ts,js,jsx,json,css,scss,vue,html}'",
		"type-check": "vue-tsc --noEmit",
		"scan:lint": "eslint src/**/*.{ts,vue} tests/**/*.{ts,vue} plugins/**/*.{ts,mjs} --format json --output-file .reports/eslint-report.json --no-fix",
		"scan:stylelint": "stylelint src/**/*.{css,scss,vue} tests/**/*.{css,scss,vue} --f json -o .reports/stylelint-report.json"
	},
	"dependencies": {
		"@basitcodeenv/vue3-device-detect": "^1.0.3",
		"axios": "^1.18.0",
		"leaflet": "^1.9.4",
		"mitt": "^3.0.1",
		"vue": "^3.5.38",
		"vue-cookies": "^1.8.6",
		"vue-router": "^5.1.0",
		"vuetify": "^4.1.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@mdi/font": "^7.4.47",
