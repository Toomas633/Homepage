{
  "folders": [
	{
		"path": "."
	},
	{
		"path": "backend"
	},
	{
		"path": "frontend"
	}
],
  "settings": {
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": true,
		"scminput": false
	},
	"github.copilot.advanced": {
		"length": 500,
		"temperature": 0.1
	},
	"powershell.cwd": "homepage",
	"window.openFoldersInNewWindow": "on",
	"window.restoreWindows": "all",
	"files.exclude": {
		"**/node_modules": false,
		"**/dist": false
	}
  }
}
