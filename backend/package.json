{
	"name": "toomas633s-dungeon-backend",
	"description": "Backend server for Toomas633's projects homepage",
	"version": "2.1.0",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"main": "dist/app.cjs",
	"engines": {
		"node": ">=18.0.0",
		"npm": ">=8.0.0"
	},
	"scripts": {
		"build": "node esbuild.config.js",
		"start": "node dist/app.cjs",
		"dev": "tsx watch src/app.ts",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src/**/* tests/**/*",
		"scan:lint": "eslint src/**/* tests/**/* --format json --output-file .reports/eslint-report.json --no-fix",
		"prettier": "prettier --write '**/*.{ts,js,jsx,json,css,scss,vue,html}'",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@types/axios": "^0.14.4",
		"axios": "^1.16.1",
		"body-parser": "^2.2.2",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"js-yaml": "^4.1.1",
		"nodemailer": "^8.0.9",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-express": "^5.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/body-parser": "^1.19.6",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.1",
		"@types/nodemailer": "^8.0.0",
		"@types/supertest": "^7.2.0",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"@vitest/coverage-v8": "^4.1.7",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.0",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"supertest": "^7.2.2",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7"
	}
}
