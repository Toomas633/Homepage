# Backend server configuration

# Email Service Configuration
# SMTP server hostname (e.g., smtp.gmail.com, mail.example.com)
EMAIL_HOST=your.email.host.com

# SMTP server port (587 for TLS, 465 for SSL, 25 for unencrypted)
EMAIL_PORT=587

# Use TLS encryption (true for port 587, false for port 465)
EMAIL_TLS=true

# Reject unauthorized TLS certificates (default: true)
# Set to false if using a self-signed or private CA certificate (e.g. Mailcow with custom CA)
EMAIL_REJECT_UNAUTHORIZED=true

# SMTP authentication username (usually your email address)
EMAIL_USER=your-email@domain.com

# SMTP authentication password or app-specific password
# For Gmail: Generate app password at https://myaccount.google.com/apppasswords
EMAIL_PASS=your-email-password

# Recipient email address for contact form submissions
EMAIL_TO=recipient@domain.com

# CORS Configuration
# Comma-separated list of allowed origins (no trailing slashes)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost

# GitHub API Configuration (Optional)
# GitHub personal access token for fetching repository data
# Increases rate limit from 60 to 5,000 requests per hour
# Get from: https://github.com/settings/tokens
# Required scopes: public_repo (for public repositories)
# Leave empty or comment out if not using GitHub integration
GITHUB_TOKEN=your_github_token_here

# First-party analytics (all optional)
# Forward events to Google Analytics 4 server-side (Measurement Protocol)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Google AdSense client id (e.g. ca-pub-xxxxxxxxxxxxxxxx), served to the frontend after ads consent
ADSENSE_CLIENT_ID=
# ****** required for GET /api/pulse/stats (Grafana / Prometheus). Endpoint is disabled when empty
ANALYTICS_STATS_TOKEN=
# Days to keep events in memory (default 30) and max events kept (default 50000)
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_MAX_EVENTS=50000

# Additional external analytics engines (all optional, events are forwarded server-side)
# Public site URL used to build absolute page URLs for destinations
ANALYTICS_SITE_URL=https://toomas633.com
# Plausible (PLAUSIBLE_URL defaults to https://plausible.io; set for self-hosted)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_URL=
# Matomo
MATOMO_URL=
MATOMO_SITE_ID=
# Generic JSON webhook (receives every event; optional bearer secret)
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_SECRET=
